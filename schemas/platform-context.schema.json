{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.vigilio.example/schemas/platform-context.schema.json",
  "title": "VIGILIO Platform Context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "repositories", "environments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "topologyTier": {
      "enum": ["compose-vps", "k8s-gitops-selfhosted", "cloud-aws-gitops"]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": {
          "enum": ["application", "platform", "service", "workspace", "frontend", "bff", "worker", "library"]
        },
        "owner": { "$ref": "#/$defs/name" },
        "lifecycle": { "enum": ["experimental", "production", "deprecated"] }
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "infrastructure", "gitops"],
      "properties": {
        "application": { "$ref": "#/$defs/repoOrRelativePath" },
        "infrastructure": { "$ref": "#/$defs/repoOrRelativePath" },
        "gitops": { "$ref": "#/$defs/repoOrRelativePath" },
        "images": { "$ref": "#/$defs/repoOrRelativePath" },
        "documentation": { "$ref": "#/$defs/repoOrRelativePath" }
      }
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["github", "gitlab", "azure-devops", "other"] },
        "gitopsEngine": { "enum": ["argocd", "flux", "none"] },
        "containerRegistry": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9.-]+(?::[0-9]{2,5})?$"
        }
      }
    },
    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["aws", "azure", "gcp", "onprem", "vps", "cloud-neutral", "hybrid"] },
        "orchestrator": { "enum": ["compose", "kubernetes", "serverless"] },
        "kubernetesDistribution": { "$ref": "#/$defs/name" }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "logs", "traces", "sloProfile"],
      "properties": {
        "metrics": { "type": "boolean" },
        "logs": { "type": "boolean" },
        "traces": { "type": "boolean" },
        "sloProfile": { "type": "string", "minLength": 1 }
      }
    },
    "reviewApps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ttl", "dataProfile"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ttl": { "type": "string", "pattern": "^[0-9]+[hm]$" },
        "dataProfile": { "type": "string", "enum": ["synthetic"] }
      }
    },
    "labs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "standard": { "$ref": "#/$defs/relativePath" },
        "runtimeSecurity": { "$ref": "#/$defs/relativePath" }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "repoOrRelativePath": {
      "oneOf": [
        { "$ref": "#/$defs/relativePath" },
        {
          "type": "string",
          "pattern": "^https://(?!.*(?:glpat-|ghp_|@))[A-Za-z0-9._/-]+$"
        }
      ]
    }
  }
}
