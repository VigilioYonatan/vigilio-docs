{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vigilio Canonical Document Schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "type",
    "status",
    "owner",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "standard",
        "foundation",
        "stack",
        "playbook",
        "runbook",
        "governance",
        "adr",
        "threat-model"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "proposed",
        "experimental",
        "stable",
        "deprecated",
        "retired"
      ]
    },
    "owner": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "applies_to": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "normative": {
      "type": "boolean"
    }
  }
}
