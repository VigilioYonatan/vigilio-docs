{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vigilio Skill Metadata Schema",
  "type": "object",
  "required": [
    "name",
    "description",
    "owner",
    "lifecycle",
    "routing_ecosystems",
    "routing_keywords",
    "routing_files",
    "routing_capabilities"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "experimental",
        "stable",
        "deprecated",
        "retired"
      ]
    },
    "routing_ecosystems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "routing_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "routing_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "routing_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "optional": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
