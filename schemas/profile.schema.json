{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Vigilio Profile Schema v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "skills"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "lifecycle": {
            "type": "string"
          },
          "extends": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
